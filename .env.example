# Copy this file to .env and fill in the values (never commit .env)

# Discord bot token (Discord Developer Portal -> your app -> Bot -> Token)
SUPER_SECRET_DISCORD_TOKEN=

# API-Football key (dashboard.api-football.com); the free tier gives 100 requests/day
API_FOOTBALL_KEY=

# Optional: play a scripted match instead of calling the API (path relative to the repo root)
# BOBER_REPLAY=data/replays/sample_match.json
